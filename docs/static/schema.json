openapi: 3.0.3
info:
  title: Servox API
  version: 1.0.0
  description: AI powered server training platform
paths:
  /api/allergytag/:
    get:
      operationId: allergytag_list
      description: Returns list of all AllergyTag
      summary: List Allergy Types
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - AllergyTag
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAllergyList'
          description: ''
  /api/allergytag/{id}/:
    get:
      operationId: allergytag_retrieve
      description: Return AllergyTag of given id
      summary: Retrieve Allergy Type
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this allergy tag.
        required: true
      tags:
      - AllergyTag
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Allergy'
          description: ''
  /api/diningtype/:
    get:
      operationId: diningtype_list
      description: Returns list of all DiningTypes
      summary: List Dining Types
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - DiningType
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDiningList'
          description: ''
  /api/diningtype/{id}/:
    get:
      operationId: diningtype_retrieve
      description: Return DiningTypes of given id
      summary: Retrieve Dining Type
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this dining type.
        required: true
      tags:
      - DiningType
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Dining'
          description: ''
  /api/product/:
    get:
      operationId: product_list
      description: Returns list of all Product
      summary: List Products
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Product
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedProductList'
          description: ''
  /api/product/{id}/:
    get:
      operationId: product_retrieve
      description: Return Product of given id
      summary: Retrieve Product
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this product.
        required: true
      tags:
      - Product
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Product'
          description: ''
  /api/session/:
    get:
      operationId: session_list
      description: Returns list of all Session
      summary: List User Training Session
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSessionList'
          description: ''
    post:
      operationId: session_create
      description: Create a new Session
      summary: Create User Training Session
      tags:
      - Session
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Session'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Session'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Session'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
  /api/session/{id}/:
    get:
      operationId: session_retrieve
      description: Return Session of given id
      summary: Retrieve User Training Session
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this session.
        required: true
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
    put:
      operationId: session_update
      description: Replace an existing Session
      summary: Update User Training Session
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this session.
        required: true
      tags:
      - Session
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Session'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Session'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Session'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
    patch:
      operationId: session_partial_update
      description: Update specific fields of an Session
      summary: Partially Update User Training Session
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this session.
        required: true
      tags:
      - Session
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedSession'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedSession'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedSession'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
    delete:
      operationId: session_destroy
      description: Delete an Session
      summary: Delete User Training Session
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this session.
        required: true
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/sessionscenario/:
    get:
      operationId: sessionscenario_list
      description: Returns list of all Scenario
      summary: List User Scenarios
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Scenario
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSessionScenarioList'
          description: ''
    post:
      operationId: sessionscenario_create
      description: Create a new Scenario
      summary: Create User Scenario
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SessionScenario'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
  /api/sessionscenario/{id}/:
    get:
      operationId: sessionscenario_retrieve
      description: Return Scenario of given id
      summary: Retrieve User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
    put:
      operationId: sessionscenario_update
      description: Replace an existing Scenario
      summary: Update User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SessionScenario'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
    patch:
      operationId: sessionscenario_partial_update
      description: Update specific fields of an Scenario
      summary: Partially Update User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedSessionScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedSessionScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedSessionScenario'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
    delete:
      operationId: sessionscenario_destroy
      description: Delete an Scenario
      summary: Delete User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/token/:
    post:
      operationId: token_create
      description: Obtain access and refresh JWT tokens by providing email and password.
      summary: Login and get JWT tokens
      tags:
      - Token
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MyTokenObtainPair'
          description: ''
  /api/token/refresh/:
    post:
      operationId: token_refresh_create
      description: Refresh an expired access token using a valid refresh token.
      summary: Refresh access token
      tags:
      - Token
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRefresh'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenRefresh'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenRefresh'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenRefresh'
          description: ''
  /api/token/verify/:
    post:
      operationId: token_verify_create
      description: Verify if a JWT token is valid or expired.
      summary: Verify token
      tags:
      - Token
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenVerify'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenVerify'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenVerify'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenVerify'
          description: ''
components:
  schemas:
    Allergy:
      type: object
      properties:
        name:
          type: string
          maxLength: 50
        id:
          type: integer
          readOnly: true
      required:
      - id
      - name
    Dining:
      type: object
      properties:
        name:
          type: string
          maxLength: 50
        code:
          type: string
          maxLength: 20
      required:
      - code
      - name
    LoginRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    MyTokenObtainPair:
      type: object
      properties:
        email:
          type: string
          format: email
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    PaginatedAllergyList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Allergy'
    PaginatedDiningList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Dining'
    PaginatedProductList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Product'
    PaginatedSessionList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Session'
    PaginatedSessionScenarioList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/SessionScenario'
    PatchedSession:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
        end_at:
          type: string
          format: date-time
          nullable: true
        last_edited:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        metadata: {}
        status:
          $ref: '#/components/schemas/StatusEnum'
        scenario:
          type: integer
        allergy:
          type: array
          items:
            type: integer
    PatchedSessionScenario:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        dining_type:
          type: integer
        allergy:
          type: integer
        name:
          type: string
          maxLength: 50
        description:
          type: string
          maxLength: 500
        guest_count:
          type: integer
          maximum: 20
          minimum: 0
    Product:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 50
        description:
          type: string
        dining_type:
          type: integer
        allergy:
          type: integer
      required:
      - allergy
      - description
      - dining_type
      - id
      - name
    Session:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
        end_at:
          type: string
          format: date-time
          nullable: true
        last_edited:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        metadata: {}
        status:
          $ref: '#/components/schemas/StatusEnum'
        scenario:
          type: integer
        allergy:
          type: array
          items:
            type: integer
      required:
      - id
      - last_edited
      - scenario
      - uuid
    SessionScenario:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        dining_type:
          type: integer
        allergy:
          type: integer
        name:
          type: string
          maxLength: 50
        description:
          type: string
          maxLength: 500
        guest_count:
          type: integer
          maximum: 20
          minimum: 0
      required:
      - allergy
      - description
      - dining_type
      - guest_count
      - id
      - name
    StatusEnum:
      enum:
      - Ongoing
      - Completed
      type: string
      description: |-
        * `Ongoing` - Ongoing
        * `Completed` - Completed
    TokenRefresh:
      type: object
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
          writeOnly: true
      required:
      - access
      - refresh
    TokenVerify:
      type: object
      properties:
        token:
          type: string
          writeOnly: true
      required:
      - token
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
