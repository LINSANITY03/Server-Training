openapi: 3.0.3
info:
  title: Servox API
  version: 1.0.0
  description: AI powered server training platform
paths:
  /api/allergytag/:
    get:
      operationId: allergytag_list
      description: Returns list of all AllergyTag
      summary: List Allergy Types
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - AllergyTag
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAllergyList'
          description: ''
  /api/allergytag/{id}/:
    get:
      operationId: allergytag_retrieve
      description: Return AllergyTag of given id
      summary: Retrieve Allergy Type
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this allergy tag.
        required: true
      tags:
      - AllergyTag
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Allergy'
          description: ''
  /api/guestprofile/:
    get:
      operationId: guestprofile_list
      description: Returns list of all Guest Profile
      summary: List Guest Profile
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - GuestProfile
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedGuestProfileList'
          description: ''
    post:
      operationId: guestprofile_create
      description: Create a new Guest Profile
      summary: Create Guest Profile
      tags:
      - GuestProfile
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GuestProfile'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/GuestProfile'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/GuestProfile'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GuestProfile'
          description: ''
  /api/guestprofile/{id}/:
    get:
      operationId: guestprofile_retrieve
      description: Return Guest Profile of given id
      summary: Retrieve Guest Profile
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this guest profile.
        required: true
      tags:
      - GuestProfile
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GuestProfile'
          description: ''
    put:
      operationId: guestprofile_update
      description: Replace an existing Guest Profile
      summary: Update Guest Profile
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this guest profile.
        required: true
      tags:
      - GuestProfile
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GuestProfile'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/GuestProfile'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/GuestProfile'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GuestProfile'
          description: ''
    patch:
      operationId: guestprofile_partial_update
      description: Update specific fields of an Guest Profile
      summary: Partially Update Guest Profile
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this guest profile.
        required: true
      tags:
      - GuestProfile
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedGuestProfile'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedGuestProfile'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedGuestProfile'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GuestProfile'
          description: ''
    delete:
      operationId: guestprofile_destroy
      description: Delete an Guest Profile
      summary: Delete Guest Profile
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this guest profile.
        required: true
      tags:
      - GuestProfile
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/scenario/:
    get:
      operationId: scenario_list
      description: Returns list of all Scenario
      summary: List User Scenarios
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Scenario
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedScenarioList'
          description: ''
    post:
      operationId: scenario_create
      description: Create a new Scenario
      summary: Create User Scenario
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Scenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Scenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Scenario'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Scenario'
          description: ''
  /api/scenario/{id}/:
    get:
      operationId: scenario_retrieve
      description: Return Scenario of given id
      summary: Retrieve User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Scenario'
          description: ''
    put:
      operationId: scenario_update
      description: Replace an existing Scenario
      summary: Update User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Scenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Scenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Scenario'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Scenario'
          description: ''
    patch:
      operationId: scenario_partial_update
      description: Update specific fields of an Scenario
      summary: Partially Update User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedScenario'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Scenario'
          description: ''
    delete:
      operationId: scenario_destroy
      description: Delete an Scenario
      summary: Delete User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/session/:
    get:
      operationId: session_list
      description: Returns list of all Session
      summary: List User Training Session
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedTrainingSessionList'
          description: ''
    post:
      operationId: session_create
      description: Create a new Session
      summary: Create User Training Session
      tags:
      - Session
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TrainingSessionCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TrainingSessionCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TrainingSessionCreate'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrainingSessionCreate'
          description: ''
  /api/session/{uuid}/:
    get:
      operationId: session_retrieve
      description: Return Session of given id
      summary: Retrieve User Training Session
      parameters:
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrainingSession'
          description: ''
    put:
      operationId: session_update
      description: Replace an existing Session
      summary: Update User Training Session
      parameters:
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Session
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TrainingSession'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TrainingSession'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TrainingSession'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrainingSession'
          description: ''
    patch:
      operationId: session_partial_update
      description: Update specific fields of an Session
      summary: Partially Update User Training Session
      parameters:
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Session
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedTrainingSession'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedTrainingSession'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedTrainingSession'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrainingSession'
          description: ''
    delete:
      operationId: session_destroy
      description: Delete an Session
      summary: Delete User Training Session
      parameters:
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/session/{uuid}/messages/:
    get:
      operationId: session_messages_list
      description: Returns conversation history for this training session.
      summary: Conversation History
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Conversation
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedConversationTurnList'
          description: ''
    post:
      operationId: session_messages_create
      description: Save a user message and trigger AI generation.
      summary: Send Message
      parameters:
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Conversation
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SendMessage'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SendMessage'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SendMessage'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TrainingSession'
          description: ''
  /api/session/{uuid}/stream/:
    get:
      operationId: session_stream_retrieve
      description: Save a user message and trigger AI generation.
      summary: Send Message
      parameters:
      - in: path
        name: uuid
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Session
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            text/event-stream:
              schema:
                $ref: '#/components/schemas/TrainingSession'
          description: ''
  /api/token/:
    post:
      operationId: token_create
      description: Obtain access and refresh JWT tokens by providing email and password.
      summary: Login and get JWT tokens
      tags:
      - Token
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MyTokenObtainPair'
          description: ''
  /api/token/refresh/:
    post:
      operationId: token_refresh_create
      description: Refresh an expired access token using a valid refresh token.
      summary: Refresh access token
      tags:
      - Token
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRefresh'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenRefresh'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenRefresh'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenRefresh'
          description: ''
  /api/token/verify/:
    post:
      operationId: token_verify_create
      description: Verify if a JWT token is valid or expired.
      summary: Verify token
      tags:
      - Token
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenVerify'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/TokenVerify'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TokenVerify'
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenVerify'
          description: ''
components:
  schemas:
    Allergy:
      type: object
      properties:
        name:
          type: string
          maxLength: 50
        id:
          type: integer
          readOnly: true
      required:
      - id
      - name
    ConversationTurn:
      type: object
      properties:
        uuid:
          type: string
          format: uuid
          readOnly: true
        role:
          $ref: '#/components/schemas/RoleEnum'
        content:
          type: string
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - content
      - created_at
      - uuid
    GuestProfile:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
        guest_count:
          type: integer
          maximum: 25
          minimum: 0
        occasion:
          type: string
          maxLength: 50
        personality:
          $ref: '#/components/schemas/PersonalityEnum'
        knowledge_level:
          $ref: '#/components/schemas/KnowledgeLevelEnum'
        notes:
          type: string
        metadata: {}
        session:
          type: integer
        allergies:
          type: array
          items:
            type: integer
      required:
      - guest_count
      - id
      - session
      - uuid
    GuestProfileCreate:
      type: object
      properties:
        guest_count:
          type: integer
          maximum: 25
          minimum: 0
        personality:
          $ref: '#/components/schemas/PersonalityEnum'
        knowledge_level:
          $ref: '#/components/schemas/KnowledgeLevelEnum'
        occasion:
          type: string
          maxLength: 50
        notes:
          type: string
        allergies:
          type: array
          items:
            type: integer
      required:
      - allergies
      - guest_count
    KnowledgeLevelEnum:
      enum:
      - low
      - medium
      - high
      type: string
      description: |-
        * `low` - Low
        * `medium` - Medium
        * `high` - High
    LoginRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    MyTokenObtainPair:
      type: object
      properties:
        email:
          type: string
          format: email
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    PaginatedAllergyList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Allergy'
    PaginatedConversationTurnList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/ConversationTurn'
    PaginatedGuestProfileList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/GuestProfile'
    PaginatedScenarioList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Scenario'
    PaginatedTrainingSessionList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/TrainingSession'
    PatchedGuestProfile:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
        guest_count:
          type: integer
          maximum: 25
          minimum: 0
        occasion:
          type: string
          maxLength: 50
        personality:
          $ref: '#/components/schemas/PersonalityEnum'
        knowledge_level:
          $ref: '#/components/schemas/KnowledgeLevelEnum'
        notes:
          type: string
        metadata: {}
        session:
          type: integer
        allergies:
          type: array
          items:
            type: integer
    PatchedScenario:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 50
        description:
          type: string
        is_active:
          type: boolean
    PatchedTrainingSession:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/StatusEnum'
          readOnly: true
        score:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          readOnly: true
        metadata: {}
        user:
          type: integer
          readOnly: true
        scenario:
          type: integer
          readOnly: true
        current_step:
          type: integer
          readOnly: true
          nullable: true
    PersonalityEnum:
      enum:
      - friendly
      - quiet
      - talkative
      - impatient
      - formal
      type: string
      description: |-
        * `friendly` - Friendly
        * `quiet` - Quiet
        * `talkative` - Talkative
        * `impatient` - Impatient
        * `formal` - Formal
    RoleEnum:
      enum:
      - AI
      - User
      - System
      type: string
      description: |-
        * `AI` - AI
        * `User` - User
        * `System` - System
    Scenario:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 50
        description:
          type: string
        is_active:
          type: boolean
      required:
      - id
      - name
    SendMessage:
      type: object
      properties:
        content:
          type: string
          maxLength: 5000
      required:
      - content
    StatusEnum:
      enum:
      - Ongoing
      - Completed
      type: string
      description: |-
        * `Ongoing` - Ongoing
        * `Completed` - Completed
    TokenRefresh:
      type: object
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
          writeOnly: true
      required:
      - access
      - refresh
    TokenVerify:
      type: object
      properties:
        token:
          type: string
          writeOnly: true
      required:
      - token
    TrainingSession:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/StatusEnum'
          readOnly: true
        score:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          readOnly: true
        metadata: {}
        user:
          type: integer
          readOnly: true
        scenario:
          type: integer
          readOnly: true
        current_step:
          type: integer
          readOnly: true
          nullable: true
      required:
      - current_step
      - id
      - scenario
      - score
      - status
      - user
      - uuid
    TrainingSessionCreate:
      type: object
      properties:
        scenario:
          type: integer
        guest_profile:
          allOf:
          - $ref: '#/components/schemas/GuestProfileCreate'
          writeOnly: true
      required:
      - guest_profile
      - scenario
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
