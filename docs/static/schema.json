openapi: 3.0.3
info:
  title: Servox API
  version: 1.0.0
  description: AI powered server training platform
paths:
  /api/allergytag/:
    get:
      operationId: allergytag_list
      description: Returns list of all AllergyTag
      summary: List Allergy Types
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - AllergyTag
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAllergyList'
          description: ''
  /api/allergytag/{id}/:
    get:
      operationId: allergytag_retrieve
      description: Return AllergyTag of given id
      summary: Retrieve Allergy Type
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this allergy tag.
        required: true
      tags:
      - AllergyTag
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Allergy'
          description: ''
  /api/diningtype/:
    get:
      operationId: diningtype_list
      description: Returns list of all DiningTypes
      summary: List Dining Types
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - DiningType
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedDiningList'
          description: ''
  /api/diningtype/{id}/:
    get:
      operationId: diningtype_retrieve
      description: Return DiningTypes of given id
      summary: Retrieve Dining Type
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this dining type.
        required: true
      tags:
      - DiningType
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Dining'
          description: ''
  /api/product/:
    get:
      operationId: product_list
      description: Returns list of all Product
      summary: List Products
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Product
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedProductList'
          description: ''
  /api/product/{id}/:
    get:
      operationId: product_retrieve
      description: Return Product of given id
      summary: Retrieve Product
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this product.
        required: true
      tags:
      - Product
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Product'
          description: ''
  /api/scenariotag/:
    get:
      operationId: scenariotag_list
      description: Returns list of all ScenarioTag
      summary: List Scenario Types
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - ScenarioTag
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedScenarioList'
          description: ''
  /api/scenariotag/{id}/:
    get:
      operationId: scenariotag_retrieve
      description: Return ScenarioTag of given id
      summary: Retrieve Scenario Type
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario tag.
        required: true
      tags:
      - ScenarioTag
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Scenario'
          description: ''
  /api/sessionscenario/:
    get:
      operationId: sessionscenario_list
      description: Returns list of all Scenario
      summary: List User Scenarios
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      tags:
      - Scenario
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSessionScenarioList'
          description: ''
    post:
      operationId: sessionscenario_create
      description: Create a new Scenario
      summary: Create User Scenario
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SessionScenario'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
  /api/sessionscenario/{id}/:
    get:
      operationId: sessionscenario_retrieve
      description: Return Scenario of given id
      summary: Retrieve User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
    put:
      operationId: sessionscenario_update
      description: Replace an existing Scenario
      summary: Update User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SessionScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SessionScenario'
        required: true
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
    patch:
      operationId: sessionscenario_partial_update
      description: Update specific fields of an Scenario
      summary: Partially Update User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedSessionScenario'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedSessionScenario'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedSessionScenario'
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionScenario'
          description: ''
    delete:
      operationId: sessionscenario_destroy
      description: Delete an Scenario
      summary: Delete User Scenario
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this scenario.
        required: true
      tags:
      - Scenario
      security:
      - cookieAuth: []
      - basicAuth: []
      responses:
        '204':
          description: No response body
components:
  schemas:
    Allergy:
      type: object
      properties:
        name:
          type: string
          maxLength: 50
      required:
      - name
    Dining:
      type: object
      properties:
        name:
          type: string
          maxLength: 50
        code:
          type: string
          maxLength: 20
      required:
      - code
      - name
    PaginatedAllergyList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Allergy'
    PaginatedDiningList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Dining'
    PaginatedProductList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Product'
    PaginatedScenarioList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/Scenario'
    PaginatedSessionScenarioList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=400&limit=100
        previous:
          type: string
          nullable: true
          format: uri
          example: http://api.example.org/accounts/?offset=200&limit=100
        results:
          type: array
          items:
            $ref: '#/components/schemas/SessionScenario'
    PatchedSessionScenario:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 50
        description:
          type: string
          maxLength: 500
        guest_count:
          type: integer
          maximum: 20
          minimum: -2147483648
        dining_type:
          type: integer
        allergy:
          type: integer
        scenario:
          type: integer
    Product:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 50
        description:
          type: string
        dining_type:
          type: integer
        allergy:
          type: integer
      required:
      - allergy
      - description
      - dining_type
      - id
      - name
    Scenario:
      type: object
      properties:
        name:
          type: string
          maxLength: 50
        description:
          type: string
          maxLength: 500
      required:
      - description
      - name
    SessionScenario:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 50
        description:
          type: string
          maxLength: 500
        guest_count:
          type: integer
          maximum: 20
          minimum: -2147483648
        dining_type:
          type: integer
        allergy:
          type: integer
        scenario:
          type: integer
      required:
      - allergy
      - description
      - dining_type
      - guest_count
      - id
      - name
      - scenario
  securitySchemes:
    basicAuth:
      type: http
      scheme: basic
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
